# common config
include core/arch/arm/cpu/cortex-armv8-0.mk

CFG_TEE_CORE_EMBED_INTERNAL_TESTS ?= y
CFG_TZDRAM_START ?= 0x2000000000
PLATFORM_FLAVOR ?= HIP09
CFG_WITH_SOFTWARE_PRNG ?= n
CFG_HISILICON_PLAT_ACC ?= y
CFG_TEE_CORE_LOG_LEVEL ?= 2
CFG_CRYPTO_WITH_CE ?= y
CFG_WITH_PAGER ?= n
CFG_WITH_STATS ?= y
CFG_EMBED_DTB_SOURCE_FILE ?= $(PLATFORM_FLAVOR).dts
CFG_CRYPTO_PBKDF2 ?= y
CFG_CRYPTO_HW_PBKDF2 ?= y
CFG_HISILICON_CRYPTO_DRIVER ?= y

# By default, the BIOS does not support parameter transfer through BTD.
CFG_BIOS_DTB ?= n

$(call force,CFG_SECURE_TIME_SOURCE_CNTPCT,y)
$(call force,CFG_CORE_IRQ_IS_NATIVE_INTR,y)
$(call force,CFG_CORE_UNMAP_CORE_AT_EL0,n)
$(call force,CFG_LPAE_ADDR_SPACE_BITS,48)
$(call force,CFG_CORE_PHYS_RELOCATABLE,y)
$(call force,CFG_WITH_ARM_TRUSTED_FW,y)
$(call force,CFG_ATTESTATION_PTA,y)
$(call force,CFG_ARM64_core,y)
$(call force,CFG_DYN_CONFIG,y)
$(call force,CFG_WITH_LPAE,y)
$(call force,CFG_ARM_GICV3,y)
$(call force,CFG_EMBED_DTB,y)
$(call force,CFG_PL011,y)
$(call force,CFG_DT,y)
CFG_TEE_DYN_VASPACE_SIZE ?= (1024 * 1024 * 40)

ifeq ($(PLATFORM_FLAVOR),HIP09)
CFG_CORE_ARM64_PA_BITS ?= 48
CFG_TEE_CORE_NB_CORE ?= 128
CFG_NUM_THREADS ?= 128
ifneq (,$(filter $(CFG_TEE_CORE_NB_CORE),128 256 512))
CFG_CPUS_PER_DIE ?= 32
CFG_CPUS_PER_SOCKET ?= 128
else ifneq (,$(filter $(CFG_TEE_CORE_NB_CORE),160 320 640))
CFG_CPUS_PER_DIE ?= 40
CFG_CPUS_PER_SOCKET ?= 160
else ifneq (,$(filter $(CFG_TEE_CORE_NB_CORE),96))
CFG_CPUS_PER_DIE ?= 24
CFG_CPUS_PER_SOCKET ?= 96
endif
CFG_HISILICON_ACC_V3 ?= y
CFG_CORE_HEAP_SIZE ?= 0x8000000
CFG_TEE_RAM_VA_SIZE ?= 0xC000000
CFG_TZDRAM_START ?= 0x82100000000
CFG_TZDRAM_SIZE  ?= 0x80000000
CFG_SHMEM_START  ?= 0x82180000000
CFG_SHMEM_SIZE   ?= 0x10000000
endif # PLATFORM_FLAVOR=HIP09
