/*
 * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
 *
 * Secure world view of the IPQ9650 RDP488 as seen by OP-TEE.
 *
 * Only what OP-TEE uses is described.
 */

/dts-v1/;

/ {
	compatible = "qcom,ipq9650-rdp488", "qcom,ipq9650";
	model = "Qualcomm Technologies, Inc. IPQ9650 RDP488";
	#address-cells = <2>;
	#size-cells = <2>;

	/* Real sizes, as nothing fills them in for the embedded DTB */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>,
		      <0x8 0x0 0x3 0x80000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		interrupt-controller@f200000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x0f200000 0x0 0x10000>,	/* GICD */
			      <0x0 0x0f240000 0x0 0xa0000>;	/* GICR */
			interrupt-controller;
			#address-cells = <0>;
			/* OP-TEE resolves at most 3 interrupt cells */
			#interrupt-cells = <3>;
		};
	};
};
