/*
 * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
 *
 * IPQ9650 RDP488 as seen by OP-TEE: only what OP-TEE uses is described.
 */

/dts-v1/;

/ {
	compatible = "qcom,ipq9650-rdp488", "qcom,ipq9650";
	model = "Qualcomm Technologies, Inc. IPQ9650 RDP488";
	#address-cells = <2>;
	#size-cells = <2>;

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x0a8fd000>,
		      <0x0 0x8a900000 0x0 0x75700000>,
		      <0x8 0x0 0x3 0x80000000>;
	};

	/*
	 * TME-Lite IPC carveout, right after TZDRAM and at
	 * CFG_TZDRAM_START + CFG_TZDRAM_SIZE. It is secure memory only, so it is
	 * not in the non-secure DRAM above, but it is listed so that it gets an
	 * XPU guard window of its own.
	 */
	memory@8a8fd000 {
		device_type = "memory";
		reg = <0x0 0x8a8fd000 0x0 0x3000>;
		status = "disabled";
		secure-status = "okay";
	};
};
