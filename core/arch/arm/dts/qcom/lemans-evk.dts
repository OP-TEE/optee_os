 *
 * Secure world view of the Lemans EVK as seen by OP-TEE.
 *
 * Only what OP-TEE uses is described.
 */

/dts-v1/;

/ {
	compatible = "qcom,lemans-evk", "qcom,qcs9100", "qcom,sa8775p";
	model = "Qualcomm Technologies, Inc. Lemans EVK";
	#address-cells = <2>;
	#size-cells = <2>;

	/* Real sizes, as nothing fills them in for the embedded DTB */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3 0x80000000>,
		      <0x8 0x0 0x8 0x0>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		interrupt-controller@17a00000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x17a00000 0x0 0x10000>,	/* GICD */
			      <0x0 0x17a60000 0x0 0x100000>;	/* GICR */
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <3>;
		};
	};
};
