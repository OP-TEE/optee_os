/*
 * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
 *
 * Secure world view of IPQ52xx as seen by OP-TEE.
 *
 * Only the properties OP-TEE consumes are described, so properties such as
 * clocks, interrupts and pinctrl are left out. The compile-time values in
 * plat-qcom stay the fallback for every node.
 */

/dts-v1/;

/ {
	compatible = "qcom,ipq5210";
	model = "Qualcomm IPQ52xx (OP-TEE)";
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart;
	};

	chosen {
		stdout-path = "serial0";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		uart: serial@1a84000 {
			compatible = "qcom,geni-debug-uart";
			reg = <0x0 0x01a84000 0x0 0x4000>;
		};
	};
};
